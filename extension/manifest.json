{
  "manifest_version": 3,
  "name": "ClientReach AI - Google Maps Assistant",
  "version": "1.2.0",
  "description": "Asisten otomasi ClientReach AI untuk ekstraksi kontak WhatsApp & data bisnis langsung dari Google Maps.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClientReach AI Scraper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
